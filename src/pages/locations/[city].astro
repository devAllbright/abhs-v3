---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewsWidget from "../../components/pages/ReviewsWidget.astro";
import FAQSection from "../../components/pages/home/FAQSection.astro";
import SectionHeading from "../../components/SectionHeading";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  return cities.map((cityEntry: CollectionEntry<"cities">) => {
    const slug = cityEntry.id.replace(/\.[^/.]+$/, "");
    return {
      params: { city: slug },
      props: { cityEntry },
    };
  });
}

export interface Props {
  cityEntry: CollectionEntry<"cities">;
}

const { cityEntry } = Astro.props;
const {
  city,
  region,
  neighborhoods: rawNeighborhoods,
  localDispatchManager,
  localPricingBaseline,
  lat,
  lng,
  zipCodes,
} = cityEntry.data;
const neighborhoods: string[] = rawNeighborhoods;

const services: CollectionEntry<"services">[] = await getCollection("services");

// Helper to map services to highly aesthetic minimal vector SVG line icons (no emojis)
const serviceIcons: Record<string, string> = {
  "one-time-maid-services": `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><path d="m15 4-1.8 1.8a2.1 2.1 0 0 0 0 3l5 5a2.1 2.1 0 0 0 3 0L23 12Z"/><path d="M17.6 8.7 8.7 17.6"/><path d="M12.5 12.5 3.5 21.5a2.1 2.1 0 1 1-3-3l9-9Z"/></svg>`,
  "deep-cleaning": `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5Z"/></svg>`,
  "carpet-cleaning": `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/><path d="M2 12h20"/></svg>`,
  "move-in-ready": `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777Zm0 0L15.5 7.5m0 0 3 3M15.5 7.5 19 4"/><path d="m12.5 10.5 2 2"/></svg>`,
  "window-washing": `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/><path d="m16 7-2.5 2.5m2.5 0L13.5 7"/></svg>`,
};
const faqs = [
  {
    question: "What types of cleaning and maintenance services do you offer?",
    answer:
      "We provide a complete range of residential cleaning and home maintenance services. This includes recurring house cleaning, deep/detail cleaning, carpet and tile cleaning, and move-in/move-out cleaning. We also offer exterior upkeep such as window washing, pressure washing, outdoor kitchen cleaning, gutter cleaning, and seasonal home maintenance plans.",
  },
  {
    question: "How do I schedule a service?",
    answer:
      "Booking is simple! Call us directly to schedule your service with one of our experts, or request a free consultation to create a personalized plan that fits your home and lifestyle. We’ll help you choose the right service, pick a convenient time, and take care of the rest.",
  },
  {
    question: "Are your cleaners and technicians background-checked?",
    answer:
      "Absolutely. All of our team members undergo background checks and professional training to ensure quality service and peace of mind.",
  },
  {
    question: "Do I need to be home during the cleaning?",
    answer:
      "Not necessarily. Many of our clients prefer to provide access and go about their day while we take care of the cleaning. You are also welcome to stay home if you prefer. Either way, you can trust our team to respect your space and follow any special instructions you provide.",
  },
  {
    question: `What areas do you serve in and around ${city}?`,
    answer:
      `We proudly serve all of ${city}, CA, including the surrounding Greater Silicon Valley and South Bay area. Our active local coverage covers neighborhoods such as ${neighborhoods.slice(0, 5).join(", ")}, and surrounding communities.`,
  },
];
---

<BaseLayout
  title={`Premium Home Cleaning Services in ${city}, CA`}
  description={`Allbright Home Services provides top-rated residential cleaning and maintenance in ${city}, California. Expert local care since 1976.`}
>
  <div class="location-hub animate-fade-in">
    <!-- Block 1: Hero Section (Value Prop & CTA) -->
    <section class="location-hub__hero">
      <div class="location-hub__hero-content">
        <div
          class="primary-banner__reviews"
          style="display: flex; align-items: center; margin-bottom: 1.5rem;"
        >
          <img
            src="/google-logo.png"
            class="primary-banner__reviews-icon"
            style="height: 2.2rem; margin-right: 0.5rem;"
            alt="Google Logo"
          />
          <img
            src="/rating-stars.svg"
            class="primary-banner__reviews-icon"
            style="height: 2.2rem; margin-right: 0.5rem;"
            alt="Rating Star"
          />
          <p
            class="primary-banner__reviews-text"
            style="font-size: 1.5rem; font-weight: 700; color: #303030; font-family: 'Lato', sans-serif;"
          >
            4.9 AVERAGE RATING
          </p>
        </div>

        <h1 class="location-hub__title">
          House Cleaning Services <br />
          <span>in {city}, CA</span>
        </h1>

        <p class="location-hub__lead">
          From customized deep cleanings to recurring maid services, Allbright
          brings nearly 50 years of award-winning, trusted home care directly to
          your neighborhood.
        </p>

        <div class="location-hub__proof">
          <div class="proof-item">
            <img class="proof-icon" src="/check.png" alt="Check Icon" />
            <p class="proof-text">
              <strong>Tailored Housekeeping:</strong> We design a custom cleaning
              framework built around your home's layout, priorities, and specific
              needs.
            </p>
          </div>
          <div class="proof-item">
            <img class="proof-icon" src="/check.png" alt="Check Icon" />
            <p class="proof-text">
              <strong>Trusted Local Experts:</strong> Uniformed, background-checked
              housekeeping professionals backed by nearly five decades of service
              excellence.
            </p>
          </div>
          <div class="proof-item">
            <img class="proof-icon" src="/check.png" alt="Check Icon" />
            <p class="proof-text">
              <strong>The Allbright Promise:</strong> Premium, non-toxic cleaning
              methods that deliver immaculate, healthy spaces for your family.
            </p>
          </div>
        </div>

        <div class="location-hub__cta-wrapper">
          <div class="location-hub__cta-buttons">
            <a href="/contact-us" class="green-cta">Book a Free Consultation</a>
            <a href={`tel:${localDispatchManager}`} class="green-outline-cta"
              >Talk to a {city} Coordinator</a
            >
          </div>
          <p class="cta-micro-copy">
            Quick 24-hour response window. No hidden contracts, no obligation.
          </p>
        </div>
      </div>
      <div class="location-hub__hero-visual">
        <div class="location-hub__dispatch-card">
          <div class="location-hub__dispatch-header">
            <span class="pulse-dot"></span>
            <h4>Territory Dispatch Status</h4>
          </div>
          <div class="location-hub__dispatch-body">
            <div class="dispatch-item">
              <span class="dispatch-label">Local Coordinator</span>
              <span class="dispatch-value">{localDispatchManager}</span>
            </div>
            <div class="dispatch-item">
              <span class="dispatch-label">Active Coverage</span>
              <span class="dispatch-value"
                >{neighborhoods.length} Major Areas</span
              >
            </div>
            <div class="dispatch-item">
              <span class="dispatch-label">Local Starting Rate</span>
              <span class="dispatch-value"
                >${localPricingBaseline.startingRate} Baseline</span
              >
            </div>
            <div class="dispatch-item">
              <span class="dispatch-label">Dispatch Coordinates</span>
              <span class="dispatch-value">{lat}° N, {lng}° W</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services-matrix" class="location-hub__matrix">
      <SectionHeading 
        title={`Professional Cleaning Services for ${city} homes`} 
        subtitle="Find the perfect cleaning service for your needs" 
      />

      <div class="services-grid">
        {
          services.map((s) => {
            const sSlug = s.id.replace(/\.[^/.]+$/, "");
            return (
              <a
                href={`/locations/${cityEntry.id.replace(
                  /\.[^/.]+$/,
                  ""
                )}/${sSlug}/`}
                class="service-card"
              >
                <h3>{s.data.title}</h3>
                <p class="service-card__summary">{s.data.summary}</p>
                <div class="service-card__price">
                  <span class="price-label">Starting at</span>
                  <span class="price-val">${s.data.basePrice}</span>
                </div>
                <span class="service-card__details-link">
                  View Details →
                </span>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Block 3: Client Reviews / Local Social Proof -->
    <section class="location-hub__reviews">
      <ReviewsWidget />
    </section>

    <!-- Block 4: Geographical Map & Local Coverage -->
    <section class="location-hub__map-coverage">
      <div class="map-coverage-container">
        <div class="coverage-details">
          <h2>Hyper-Local Dispatch Center</h2>
          <p>
            Our local coordinator, <strong>{localDispatchManager}</strong>,
            manages all local service trucks in the {city} area, ensuring prompt
            arrivals, eco-friendly equipment setups, and strict adherence to Allbright's
            premium standards.
          </p>
          <div class="bullet-item">
            <span class="bullet-icon">✓</span>
            <div>
              <strong>Local Dispatch:</strong> Fast response times for priority bookings
              and emergency cleanings.
            </div>
          </div>
          <div class="bullet-item">
            <span class="bullet-icon">✓</span>
            <div>
              <strong>Eco-Friendly Care:</strong> 100% safe for your family, pets,
              and the local {city} ecosystem.
            </div>
          </div>

          <div class="coverage-neighborhoods">
            <h3>Covered Neighborhoods & Boundaries</h3>
            <p>
              We provide full residential coverage across all major areas in {
                city
              }, CA, including:
            </p>
            <div class="neighborhoods-grid">
              {
                neighborhoods.map((n) => (
                  <span class="neighborhood-tag">{n}</span>
                ))
              }
            </div>
            <p class="zip-coverage">
              <strong>Active Zip Codes:</strong>
              {zipCodes.join(", ")}
            </p>
          </div>
        </div>

        <div class="map-visual-container">
          <div class="map-card animate-slide-in">
            <div class="map-card-header">
              <span class="pulse-dot"></span>
              <h4>{city} Operating Footprint</h4>
            </div>
            <div class="map-iframe-wrapper">
              <iframe
                title={`Allbright Home Services coverage map in ${city}, CA`}
                src={`https://maps.google.com/maps?q=${lat},${lng}&t=&z=12&ie=UTF8&iwloc=&output=embed`}
                width="100%"
                height="100%"
                style="border:0; min-height: 380px; border-radius: 12px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <div class="map-card-footer">
              <span
                ><strong>Hub Coordinator:</strong> {localDispatchManager}
              </span>
              <span><strong>Coordinates:</strong> {lat}° N, {lng}° W</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Block 5: Frequently Asked Questions (Homepage Style) -->
  <FAQSection faqs={faqs} />
</BaseLayout>

<style lang="scss">
  .location-hub {
    font-family: "Lato", sans-serif;
    color: #0f172a;
    background: #ffffff;
    overflow-x: hidden;

    &__hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem 4rem 2rem;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
      align-items: center;

      @media (max-width: 968px) {
        grid-template-columns: 1fr;
        padding-top: 4rem;
        gap: 2rem;
      }
    }

    &__hero-content {
      animation: slideInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      max-width: 60rem;
    }

    &__badge {
      display: inline-block;
      background: rgba(252, 133, 81, 0.1);
      color: #fc8551;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      margin-bottom: 1.5rem;
    }

    &__title {
      font-family: "Merriweather", serif;
      font-size: 3.8rem;
      font-weight: 300;
      line-height: 1.25;
      color: #303030;
      margin: 0 0 1.5rem 0;

      span {
        font-weight: 700;
        color: #299c36;
      }

      @media (max-width: 576px) {
        font-size: 2.8rem;
      }
    }

    &__lead {
      font-family: "Lato", sans-serif;
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1.4;
      color: #303030;
      margin-top: 1.5rem;
      margin-bottom: 2.5rem;
    }

    &__proof {
      margin-bottom: 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;

      .proof-item {
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
      }

      .proof-icon {
        width: 2.2rem;
        height: 2.2rem;
        flex-shrink: 0;
        margin-top: 0.2rem;
      }

      .proof-text {
        font-family: "Lato", sans-serif;
        font-size: 1.6rem;
        line-height: 1.4;
        color: #475569;
        margin: 0;

        strong {
          color: #303030;
          font-weight: 700;
        }
      }
    }

    &__cta-wrapper {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    &__cta-buttons {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .green-cta {
      background-color: #299c36 !important;
      color: #ffffff !important;
      border: 1px solid #299c36 !important;
      border-radius: 4px;
      font-family: "Lato", sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      padding: 1.2rem 2.4rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      transition: all 0.2s ease;
      cursor: pointer;

      &:hover {
        background-color: #1e7a27 !important;
        border-color: #1e7a27 !important;
        transform: translateY(-1px);
      }
    }

    .green-outline-cta {
      background-color: transparent !important;
      color: #299c36 !important;
      border: 1px solid #299c36 !important;
      border-radius: 4px;
      font-family: "Lato", sans-serif;
      font-size: 1.6rem;
      font-weight: 700;
      padding: 1.2rem 2.4rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      transition: all 0.2s ease;
      cursor: pointer;

      &:hover {
        background-color: rgba(41, 156, 54, 0.05) !important;
        transform: translateY(-1px);
      }
    }

    .cta-micro-copy {
      font-family: "Lato", sans-serif;
      font-size: 1.3rem;
      font-style: italic;
      color: #64748b;
      margin: 0.5rem 0 0 0;
    }

    &__hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      animation: slideInRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      width: 100%;
    }

    &__dispatch-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 4rem;
      width: 100%;
      max-width: 460px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05),
        0 10px 10px -5px rgba(0, 0, 0, 0.02);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

      &:hover {
        transform: translateY(-4px);
        box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.08);
        border-color: #299c36;
      }
    }

    &__dispatch-header {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 1.5rem;
      margin-bottom: 2.5rem;

      h4 {
        margin: 0;
        font-family: "Lato", sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e293b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
    }

    .pulse-dot {
      width: 12px;
      height: 12px;
      background: #22c55e;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
      animation: pulse 2s infinite;
      flex-shrink: 0;
    }

    &__dispatch-body {
      display: flex;
      flex-direction: column;
      gap: 2.2rem;

      .dispatch-item {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .dispatch-label {
        font-family: "Lato", sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .dispatch-value {
        font-family: "Lato", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: #1e293b;
      }
    }

    /* Matrix Section */
    &__matrix {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem 6rem 2rem;



      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
      }

      .service-card {
        background: linear-gradient(135deg, #ffffff 0%, #fffcfb 100%);
        border: 1px solid #f1f5f9;
        border-left: 4px solid #fc8551;
        border-radius: 16px;
        padding: 2.2rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        position: relative;
        overflow: hidden;
        text-decoration: none;
        color: inherit;

        &:hover {
          transform: translateY(-4px);
          box-shadow: 0 15px 30px rgba(252, 133, 81, 0.08);
          border-left-color: #299c36;
          background: linear-gradient(135deg, #ffffff 0%, #f6faf6 100%);

          .service-card__details-link {
            color: #299c36;
            transform: translateX(4px);
          }
        }

        h3 {
          font-family: "Lato", sans-serif;
          font-size: 1.8rem;
          font-weight: 800;
          color: #1e293b;
          margin: 0 0 0.75rem 0;
          line-height: 1.25;
        }

        &__summary {
          font-family: "Lato", sans-serif;
          font-size: 1.25rem;
          line-height: 1.5;
          color: #475569;
          margin: 0 0 1.5rem 0;
          flex-grow: 1;
        }

        &__price {
          display: flex;
          align-items: baseline;
          gap: 0.5rem;
          margin-bottom: 1.5rem;
          border-top: 1px solid #f1f5f9;
          padding-top: 1.2rem;

          .price-label {
            font-size: 0.95rem;
            color: #94a3b8;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.05em;
          }

          .price-val {
            font-size: 2.1rem;
            font-weight: 800;
            color: #299c36;
          }
        }

        &__details-link {
          display: inline-flex;
          align-items: center;
          color: #fc8551;
          text-decoration: none;
          font-weight: 700;
          font-size: 1.2rem;
          transition: all 0.2s ease;
          margin-top: auto;
          width: fit-content;
        }
      }
    }

    /* Reviews Widget Section */
    &__reviews {
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
      padding: 6rem 2rem;
    }

    /* Map & Coverage Section */
    &__map-coverage {
      padding: 6rem 2rem;
      background: #ffffff;

      .map-coverage-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: center;

        @media (max-width: 968px) {
          grid-template-columns: 1fr;
          gap: 4rem;
        }
      }

      h2 {
        font-size: 3.2rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0 0 1.5rem 0;
        line-height: 1.2;
      }

      p {
        font-size: 1.5rem;
        line-height: 1.6;
        color: #475569;
        margin-bottom: 2.5rem;
      }

      .bullet-item {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        margin-bottom: 1.8rem;

        .bullet-icon {
          width: 28px;
          height: 28px;
          background: #22c55e;
          color: white;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 1rem;
          font-weight: bold;
          flex-shrink: 0;
        }

        strong {
          color: #1e293b;
          font-weight: 700;
        }

        div {
          font-size: 1.45rem;
          color: #475569;
          line-height: 1.5;
        }
      }

      .coverage-neighborhoods {
        margin-top: 3.5rem;
        background: #f8fafc;
        padding: 3.5rem;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05),
          0 10px 10px -5px rgba(0, 0, 0, 0.02);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

        &:hover {
          transform: translateY(-4px);
          box-shadow: 0 25px 30px -5px rgba(0, 0, 0, 0.08);
          border-color: #299c36;
        }

        h3 {
          font-size: 2.4rem;
          font-weight: 800;
          color: #1e293b;
          margin: 0 0 1.2rem 0;
        }

        p {
          font-size: 1.65rem;
          line-height: 1.5;
          margin-bottom: 2rem;
          color: #475569;
        }
      }

      .neighborhoods-grid {
        display: flex;
        flex-wrap: wrap;
