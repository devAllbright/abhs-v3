    /* Client Reviews Section */
    &__reviews {
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      padding: 6rem 2rem;
    }

    /* Neighborhoods */
    &__neighborhoods {
      background: #ffffff;
      padding: 6rem 2rem;
      border-bottom: 1px solid #e2e8f0;

      .neighborhoods-container {
        max-width: 1200px;
        margin: 0 auto;
