---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LeadForm from "../../../components/forms/LeadForm";
import LocalPricingChart from "../../../components/LocalPricingChart";
import ReviewsWidget from "../../../components/pages/ReviewsWidget.astro";
import SectionHeading from "../../../components/SectionHeading";
import FAQSection from "../../../components/pages/home/FAQSection.astro";
import pricingJune from "../../../data/pricing-june.json";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  const services = await getCollection("services");
  return cities.flatMap((cityEntry: CollectionEntry<"cities">) => {
    const citySlug = cityEntry.id.replace(/\.[^/.]+$/, "");
    return services.map((serviceEntry: CollectionEntry<"services">) => {
      const serviceSlug = serviceEntry.id.replace(/\.[^/.]+$/, "");
      return {
        params: {
          city: citySlug,
          service: serviceSlug,
        },
        props: { cityEntry, serviceEntry },
      };
    });
  });
}

export interface Props {
  cityEntry: CollectionEntry<"cities">;
  serviceEntry: CollectionEntry<"services">;
}

const { cityEntry, serviceEntry } = Astro.props;
const {
  city,
  region,
  neighborhoods: rawNeighborhoods,
  localDispatchManager,
  localPricingBaseline,
  lat,
  lng,
  zipCodes,
} = cityEntry.data;
const neighborhoods: string[] = rawNeighborhoods;
const {
  name,
  title,
  summary,
  description,
  basePrice,
  parentHubPath,
  descriptionData,
  reasonsData,
  finalCTAData,
  faqs: rawFaqs,
} = serviceEntry.data;
const faqs: { question: string; answer: string }[] = rawFaqs;
const localizedFaqs = faqs.map(faq => ({
  question: faq.question,
  answer: faq.answer.replace(/Your Home/g, `Your ${city} Home`),
}));

const serviceSlug = serviceEntry.id.replace(/\.[^/.]+$/, "");
const serviceId = serviceSlug === "home-detailing-cleaning"
  ? "home_detailing"
  : serviceSlug.replace(/-/g, "_");

const junePricingEntry = (pricingJune as any)["pricing-june"][serviceId];
const perRoomPrices = junePricingEntry?.per_room || {
  "1_bed_1_bath": 149,
  "2_bed_1_bath": 179,
  "3_bed_2_bath": 209,
  "4_bed_3_bath": 249
};

// Generate local coordinates for Business Schema
const streetAddress = `${city} Dispatch Center`;
const postalCode = zipCodes[0] || "";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Allbright Home Services",
  image: "https://www.allbrighths.com/allbright-logo.png",
  telephone: "(408) 280-1234",
  email: "contact@allbrighths.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: streetAddress,
    addressLocality: city,
    addressRegion: "CA",
    postalCode: postalCode,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: lat,
    longitude: lng,
  },
  url: "https://www.allbrighths.com",
  priceRange: "$$",
  areaServed: {
    "@type": "AdministrativeArea",
    name: city,
  },
  description: `${title} in ${city}, CA`,
};
---

<BaseLayout
  title={`${title} in ${city}, CA | Allbright Home Services`}
  description={`${summary} in ${city}, California. Restore freshness, sanitization, and cleanliness with the leading residential experts.`}
>
  <!-- Hardcoded LocalBusiness Schema inside the header context -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="local-spoke animate-fade-in">
    <!-- Block 1: Primary Hero Section (Service-Specific Value Prop & CTA) -->
    <section class="local-spoke__hero">
      <div class="hero-container">
        <div class="hero-left">
          <div
            class="primary-banner__reviews"
            style="display: flex; align-items: center; margin-bottom: 1.5rem;"
          >
            <img
              src="/google-logo.png"
              class="primary-banner__reviews-icon"
              style="height: 2.2rem; margin-right: 0.5rem;"
              alt="Google Logo"
            />
            <img
              src="/rating-stars.svg"
              class="primary-banner__reviews-icon"
              style="height: 2.2rem; margin-right: 0.5rem;"
              alt="Rating Star"
            />
            <p
              class="primary-banner__reviews-text"
              style="font-size: 1.5rem; font-weight: 700; color: #303030; font-family: 'Lato', sans-serif;"
            >
              4.9 AVERAGE RATING
            </p>
          </div>

          <h1 class="hero-title">
            Professional {title}
            <br />
            <span>in {city}, CA</span>
          </h1>

          <p class="hero-lead">{description}</p>

          <div class="hero-proof">
            <div class="proof-item">
              <img class="proof-icon" src="/check.png" alt="Check Icon" />
              <p class="proof-text">
                <strong>Premium Experience:</strong> Nearly 50 years of award-winning
                residential cleaning expertise.
              </p>
            </div>
            <div class="proof-item">
              <img class="proof-icon" src="/check.png" alt="Check Icon" />
              <p class="proof-text">
                <strong>The Allbright Promise:</strong> 100% Satisfaction Guarantee.
                If you're not happy, we make it right.
              </p>
            </div>
            <div class="proof-item">
              <img class="proof-icon" src="/check.png" alt="Check Icon" />
              <p class="proof-text">
                <strong>Eco-Friendly Care:</strong> Safe, non-toxic green formulas
                for pets, kids, and the local ecosystem.
              </p>
            </div>
          </div>

          <div class="hero-cta-wrapper">
            <div class="hero-cta-buttons">
              <a href="/contact-us" class="green-cta"
                >Book a Free Consultation</a
              >
              <a href={`tel:${localDispatchManager}`} class="green-outline-cta"
                >Talk to a {city} Coordinator</a
              >
            </div>
            <p class="cta-micro-copy">
              Quick 24-hour response window. No hidden contracts, no obligation.
            </p>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-right-wrapper">
            <!-- Lead Form to maximize conversions -->
            <div class="hero-form-wrapper">
              <LeadForm client:load onSuccess={() => {}} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="local-spoke__booking">
      <div class="booking-container">
        <SectionHeading
          title={`Local Rates for ${city}`}
          subtitle="Get a quick localized estimate or browse our baseline tiered pricing matrix below."
        />

        <div class="booking-grid">
          <div class="booking-left">
            <div class="pricing-matrix-card">
              <h3>{city} Baseline Rates</h3>
              <p class="matrix-description">
                Average flat-rate ranges for {title.toLowerCase()} based on standard
                home configurations:
              </p>

              <table class="matrix-table">
                <thead>
                  <tr>
                    <th>Home Layout</th>
                    <th>Starting Rate</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>1 Bed, 1 Bath</strong></td>
                    <td class="price-cell">starting at ${perRoomPrices["1_bed_1_bath"]}</td>
                  </tr>
                  <tr>
                    <td><strong>2 Bed, 1 Bath</strong></td>
                    <td class="price-cell">starting at ${perRoomPrices["2_bed_1_bath"]}</td>
                  </tr>
                  <tr>
                    <td><strong>3 Bed, 2 Bath</strong></td>
                    <td class="price-cell">starting at ${perRoomPrices["3_bed_2_bath"]}</td>
                  </tr>
                  <tr>
                    <td><strong>4 Bed, 3 Bath</strong></td>
                    <td class="price-cell">starting at ${perRoomPrices["4_bed_3_bath"]}</td>
                  </tr>
                </tbody>
              </table>

              <div class="pricing-bullets">
                <h4>Upfront Pricing Variables</h4>
                <ul>
                  <li>
                    <strong>Zero Hidden Fees:</strong> Quotes include all cleaning
                    supplies, taxes, and labor.
                  </li>
                  <li>
                    <strong>Flexible Addons:</strong> Choose eco-friendly green formulas,
                    deep scrubbing, or window washing.
                  </li>
                  <li>
                    <strong>Frequency Savings:</strong> Recurring maintenance clients
                    receive up to 20% off future cleanings.
                  </li>
                  <li>
                    <strong>Local Territory Baseline:</strong> Rates calibrated specifically
                    to the {city} region and active zip codes.
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="booking-right">
            <LocalPricingChart
              city={city}
              serviceTitle={title}
              serviceId={serviceId}
              basePrice={basePrice}
              discountCode={localPricingBaseline.discountCode || "BAY15"}
              client:load
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Block 3: The "How It Works" 3-Step Micro-Funnel (New Section) -->
    <section class="local-spoke__how-it-works">
      <div class="how-it-works-container">
        <SectionHeading
          title={`How Our ${city} ${title} Service Works`}
          subtitle={`Under ${localDispatchManager}, our regional hub handles the logistics so you can easily schedule a cleaner in ${city}, CA.`}
        />

        <div class="guarantee-header">
          <h3 class="guarantee-title">
            Our Step-by-Step Local Service Guarantee
          </h3>
        </div>

        <div class="funnel-grid">
          <div class="funnel-card">
            <div class="funnel-badge">01</div>
            <span class="funnel-step">Step 01</span>
            <h3>Secure Your Pricing & Spot Online</h3>
            <p>
              Pick your preferred day and secure your local consultation in
              under 60 seconds with instant booking confirmation. No hidden
              fees, no estimation stress.
            </p>
          </div>

          <div class="funnel-card">
            <div class="funnel-badge">02</div>
            <span class="funnel-step">Step 02</span>
            <h3>A Trusted, Vetted Local Cleaner Arrives</h3>
            <p>
              {localDispatchManager} syncs with our background-checked, fully insured
              {city} crews to ensure your cleaner arrives exactly on time, equipped
              with premium eco-friendly green formulas and advanced tools.
            </p>
          </div>

          <div class="funnel-card">
            <div class="funnel-badge">03</div>
            <span class="funnel-step">Step 03</span>
            <h3>Walk Into a Spotless, Sanitized Home</h3>
            <p>
              Enjoy a completely fresh, perfectly sanitized, and spotless
              environment. Every single {title.toLowerCase()} service is backed by
              our strict 100% Satisfaction Guarantee—if it isn't perfect, we make
              it right.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Block 4: Service Features & Value Proposition (Objection Handling) -->
    <section class="local-spoke__features">
      <div class="features-container">
        <SectionHeading
          title={`Vetted & Fully Insured ${title} in ${city}, CA`}
          subtitle={`We eliminate liability risks, safety concerns, and scheduling delays for homeowners in ${city}.`}
        />

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🛡️</div>
            <h3>Fully Insured & Bonded Protection</h3>
            <ul class="feature-bullets">
              <li>
                <strong>Total Liability Coverage:</strong> We assume 100% of the liability for your home, assets, and keys.
              </li>
              <li>
                <strong>Premium Umbrella Security:</strong> Every cleanup is executed under our comprehensive, zero-risk safety umbrella.
              </li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>100% Background-Checked Crews</h3>
            <ul class="feature-bullets">
              <li>
                <strong>Rigorous Federal Screening:</strong> Every neighborhood service crew member passes strict federal background checks.
              </li>
              <li>
                <strong>Sanitization Standards:</strong> Certified local teams complete mandatory professional training and strict sanitization checks.
              </li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🌿</div>
            <h3>Eco-Friendly Cleaning Supplies Supplied</h3>
            <ul class="feature-bullets">
              <li>
                <strong>State-of-the-Art Green Formulas:</strong> We strictly deploy non-toxic, premium formulas on every project.
              </li>
              <li>
                <strong>{city} Environmental Safety:</strong> Formulations are safe for pets, infants, and the local {city} watershed.
              </li>
            </ul>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🏆</div>
            <h3>Legacy of Premium Care Since 1976</h3>
            <ul class="feature-bullets">
              <li>
                <strong>Decades of Local Craftsmanship:</strong> Bringing 50 years of award-winning, local California expertise directly to your door.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Block 5: Client Reviews & Testimonials -->
    <section class="local-spoke__reviews">
      <ReviewsWidget />
    </section>

    <!-- Block 6: Specific Neighborhoods / Areas Covered -->
    <section class="local-spoke__neighborhoods">
      <div class="neighborhoods-container">
        <SectionHeading
          title="Hyper-Local Coverage Boundaries"
          subtitle={`Our dispatch coordinate truck fleet services all major neighborhoods, streets, and blocks within ${city}, CA:`}
        />

        <div class="neighborhoods-grid">
          {
            neighborhoods.map((n) => (
              <div class="neighborhood-card">
                <span class="neighborhood-dot">✦</span>
                <span class="neighborhood-name">{n}</span>
              </div>
            ))
          }
        </div>
        <div class="zip-list">
          <strong>Active coverage zip codes in {city}:</strong>{" "}
          {zipCodes.join(", ")}
        </div>
      </div>
    </section>

    <!-- Block 7: Local FAQ Section -->
    <FAQSection faqs={localizedFaqs} />
  </div>
</BaseLayout>

<style lang="scss">
  .local-spoke {
    font-family: "Lato", sans-serif;
    color: #0f172a;
    background: #ffffff;
    overflow-x: hidden;

    /* Hero */
    &__hero {
      background: #ffffff;
      padding: 6rem 2rem;

      @media (max-width: 968px) {
        padding: 4rem 1.5rem;
      }

      .hero-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
        align-items: center;

        @media (max-width: 968px) {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
      }

      .hero-left {
        max-width: 60rem;
      }

      .hero-title {
        font-family: "Merriweather", serif;
        font-size: 3.8rem;
        font-weight: 300;
        line-height: 1.25;
        color: #303030;
        margin: 0 0 1.5rem 0;

        span {
          font-weight: 700;
          color: #299c36;
        }

        @media (max-width: 576px) {
          font-size: 2.8rem;
        }
      }

      .hero-lead {
        font-family: "Lato", sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1.4;
        color: #303030;
        margin-top: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .hero-proof {
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;

        .proof-item {
          display: flex;
          align-items: flex-start;
          gap: 1.2rem;
        }

        .proof-icon {
          width: 2.2rem;
          height: 2.2rem;
          flex-shrink: 0;
          margin-top: 0.2rem;
        }

        .proof-text {
          font-family: "Lato", sans-serif;
          font-size: 1.6rem;
          line-height: 1.4;
          color: #475569;
          margin: 0;

          strong {
            color: #303030;
            font-weight: 700;
          }
        }
      }

      .hero-cta-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2.5rem;
      }

      .hero-cta-buttons {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .green-cta {
        background-color: #299c36 !important;
        color: #ffffff !important;
        border: 1px solid #299c36 !important;
        border-radius: 4px;
        font-family: "Lato", sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        padding: 1.2rem 2.4rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: all 0.2s ease;
        cursor: pointer;

        &:hover {
          background-color: #1e7a27 !important;
          border-color: #1e7a27 !important;
          transform: translateY(-1px);
        }
      }

      .green-outline-cta {
        background-color: transparent !important;
        color: #299c36 !important;
        border: 1px solid #299c36 !important;
        border-radius: 4px;
        font-family: "Lato", sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        padding: 1.2rem 2.4rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: all 0.2s ease;
        cursor: pointer;

        &:hover {
          background-color: rgba(41, 156, 54, 0.05) !important;
          transform: translateY(-1px);
        }
      }

      .cta-micro-copy {
        font-family: "Lato", sans-serif;
        font-size: 1.3rem;
        font-style: italic;
        color: #64748b;
        margin: 0.5rem 0 0 0;
      }

      .hero-right-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .hero-image-placeholder {
        width: 100%;
        height: 200px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;

        .cleaner-action-img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          filter: brightness(0.95);
        }
      }

      .hero-form-wrapper {
        background: white;
        border-radius: 16px;
        box-shadow:
          0 20px 25px -5px rgba(0, 0, 0, 0.1),
          0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid #e2e8f0;
        overflow: hidden;
      }
    }

    /* Booking / Pricing Grid */
    &__booking {
      background: #ffffff;
      padding: 6rem 2rem;
      border-bottom: 1px solid #e2e8f0;

      .booking-container {
        max-width: 1200px;
        margin: 0 auto;
        text-align: left;
      }

      .booking-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 3.5rem;
        align-items: stretch;

        @media (max-width: 968px) {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
      }

      .booking-left {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
      }

      .booking-right {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
      }

      .pricing-matrix-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 3.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        height: 100%;
        display: flex;
        flex-direction: column;

        h3 {
          font-size: 1.8rem;
          font-weight: 800;
          color: #1e293b;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          margin: 0 0 1rem 0;
        }

        .matrix-description {
          font-size: 1.3rem;
          color: #64748b;
          line-height: 1.5;
          margin-bottom: 2rem;
        }

        .matrix-table {
          width: 100%;
          border-collapse: collapse;
          margin-bottom: 2.5rem;

          th {
            text-align: left;
            padding: 1rem;
            font-size: 1.1rem;
            text-transform: uppercase;
            color: #64748b;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;

            &:last-child {
              text-align: right;
            }
          }

          td {
            padding: 1.2rem 1rem;
            font-size: 1.35rem;
            color: #334155;
            border-bottom: 1px solid #e2e8f0;
          }

          .price-cell {
            font-weight: 700;
            color: #299c36;
            text-align: right;
            font-size: 1.45rem;
          }

          tr:last-child td {
            border-bottom: none;
          }
        }

        .pricing-bullets {
          margin-top: auto;
          h4 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 1.25rem 0;
          }

          ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 1rem;

            li {
              font-size: 1.25rem;
              line-height: 1.5;
              color: #475569;
              position: relative;
              padding-left: 1.8rem;

              &::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: #22c55e;
                font-weight: bold;
              }

              strong {
                color: #1e293b;
              }
            }
          }
        }
      }
    }

    /* How It Works Micro-Funnel */
    &__how-it-works {
      background: radial-gradient(circle at 50% 0%, #ffffff 0%, #f8fafc 100%);
      padding: 8rem 2rem;
      border-bottom: 1px solid #e2e8f0;

      .how-it-works-container {
        max-width: 1200px;
        margin: 0 auto;

        :global(.section-heading__subtitle) {
          font-size: 2.2rem !important;
          line-height: 1.65 !important;
          max-width: 95rem !important;
          color: #475569 !important;
          margin-bottom: 5rem !important;
        }
      }

      .guarantee-header {
        text-align: center;
        margin: -1.5rem auto 4.5rem auto;
      }

      .guarantee-title {
        font-family: "Lato", sans-serif;
        font-size: 2.2rem;
        font-weight: 800;
        color: #299c36;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        position: relative;
        display: inline-block;
        padding-bottom: 0.8rem;
        margin: 0;

        &::after {
          content: "";
          position: absolute;
          bottom: 0;
          left: 25%;
          width: 50%;
          height: 3px;
          background: linear-gradient(90deg, #299c36, #4cd05c);
          border-radius: 99px;
        }

        @media (max-width: 768px) {
          font-size: 1.6rem;
        }
      }

      .funnel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 3rem;
      }

      .funnel-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 24px;
        padding: 3.5rem 3rem 4rem 3rem;
        position: relative;
        box-shadow:
          0 10px 30px -10px rgba(0, 0, 0, 0.04),
          0 1px 3px rgba(0, 0, 0, 0.01);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;

        &:hover {
          transform: translateY(-6px);
          box-shadow:
            0 20px 40px -15px rgba(41, 156, 54, 0.12),
            0 0 0 1px rgba(41, 156, 54, 0.2);
          border-color: #299c36;

          .funnel-badge {
            color: rgba(41, 156, 54, 0.06);
            transform: scale(1.1);
          }

