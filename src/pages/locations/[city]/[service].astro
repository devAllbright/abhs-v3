        max-width: 1200px;
        margin: 0 auto;
        text-align: left;
      }

      .booking-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 3.5rem;
        align-items: stretch;

        @media (max-width: 968px) {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
      }

      .booking-left {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: stretch;
