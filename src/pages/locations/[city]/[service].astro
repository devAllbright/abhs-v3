          transform: translateY(-4px);
          box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.05);
          border-color: #fc8551;
        }
      }

      .funnel-badge {
        position: absolute;
        top: 2rem;
        right: 2rem;
        font-size: 2.5rem;
        font-weight: 800;
        color: rgba(252, 133, 81, 0.15);
        font-family: "Montserrat", sans-serif;
      }

      h3 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 1rem 0;
      }

      p {
        font-size: 1.05rem;
        line-height: 1.6;
        color: #475569;
        margin: 0;
      }
    }

    /* Service Features Section */
    &__features {
      background: #ffffff;
      padding: 6rem 2rem;
      border-bottom: 1px solid #e2e8f0;

      .features-container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .features-header {
        text-align: center;
        margin-bottom: 4rem;

        h2 {
          font-size: 2.5rem;
          font-weight: 800;
          color: #1e293b;
          margin: 0 0 0.5rem 0;
        }

        p {
          font-size: 1.15rem;
          color: #64748b;
          margin: 0;
        }
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2rem;
      }

      .feature-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 2.5rem;
        transition: transform 0.25s ease, border-color 0.25s ease;

        &:hover {
          transform: translateY(-4px);
          border-color: #fc8551;
        }
      }

      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
      }

      h3 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.75rem 0;
      }

      p {
        font-size: 1rem;
        line-height: 1.55;
        color: #475569;
        margin: 0;
      }
